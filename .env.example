# Modelo do .env — copie para `.env` e preencha. O .env de verdade NÃO vai
# para o repositório.

# Envio de e-mail (aviso de clichê). Sem isto o hub funciona; só não manda
# e-mail, e diz isso na tela.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CLICHE_EMAIL_TO=

# Caminhos. Em produção ficam nos valores de baixo; o `npm run dev:teste` já
# passa os dele por linha de comando e não usa este arquivo.
# DESIGNHUB_DB=./data/designhub.db
# CLIENTES_DIR=\\server\Arte\Clientes
